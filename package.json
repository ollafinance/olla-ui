{
  "name": "@olla-ui/monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @olla-ui/frontend dev",
    "build": "yarn workspaces foreach -A run build",
    "lint": "yarn workspaces foreach -A run lint",
    "types:generate": "yarn workspace @olla-ui/types generate"
  }
}
